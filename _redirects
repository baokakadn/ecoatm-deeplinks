# ─────────────────────────────────────────────────────────────────────────────
# Netlify _redirects
# ─────────────────────────────────────────────────────────────────────────────

# ── Channel entry points → index.html (200 = rewrite, URL stays clean)
/email    /index.html  200
/sms      /index.html  200
/push     /index.html  200
/social   /index.html  200
/qr       /index.html  200

# ── Short-link aliases (SMS brevity)
/s/:code  /index.html?ref=:code  200

# ── Named screen shortcuts
/find-kiosk             /index.html?screen=find-kiosk  200
/find-kiosk/:id         /index.html?screen=find-kiosk&kiosk_id=:id  200
/sell                   /index.html?screen=sell  200
/sell/this-device       /index.html?screen=sell&sub-screen=this-device  200
/offers                 /index.html?screen=offers  200
/offers/:id             /index.html?screen=offers&offer_id=:id  200
/account                /index.html?screen=account  200
/home                   /index.html?screen=home  200
/price-view/:id         /index.html?screen=price-view&estimate_id=:id  200

# ── Well-known files — must be direct 200, never redirected
/.well-known/apple-app-site-association  /.well-known/apple-app-site-association  200
/.well-known/assetlinks.json             /.well-known/assetlinks.json              200

# ── Catch-all → index
/*  /index.html  200